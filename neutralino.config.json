{
  "applicationId": "com.kieai.kiechan",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "documentRoot": "/",
  "url": "/index.html",
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "events.*",
    "computer.*"
  ],
  "modes": {
    "window": {
      "title": "Kie-Chan!",
      "width": 510,
      "height": 720,
      "minWidth": 280,
      "minHeight": 380,
      "resizable": true,
      "borderless": true,
      "transparent": true,
      "alwaysOnTop": true,
      "icon": "/icon.png"
    }
  },
  "cli": {
    "binaryName": "kie-chan",
    "resourcesPath": "/",
    "clientLibrary": "/neutralino.js",
    "distributionPath": "/dist/",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}